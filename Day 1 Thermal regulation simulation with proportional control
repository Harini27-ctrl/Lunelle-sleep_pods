Lunelle Sleep Pod — Day 1
==========================
Thermal regulation simulation for space sleep habitats.

This is the Day 1 snapshot — thermal module only.

What was built:
    - Newton's Law of Cooling physics model
    - Metabolic heat generation
    - Proportional feedback controller
    - Gaussian sensor noise modeling
    - Moving average filter (noise reduction)
    - State-based cooling trigger (stability detection)
    - Timeout fallback (deadlock prevention)
    - Three-scenario comparison: Earth vs Microgravity vs Lunelle

Key insight from Day 1:
    Microgravity impairs natural heat dissipation (k_space = 0.015
    vs k_earth = 0.05). Without intervention, body temperature never
    reaches the 36°C sleep onset threshold. Lunelle's proportional
    controller bridges this gap using closed-loop feedback control.

Author: Lunelle Project
Status: Day 1 Complete — thermal module
"""

import numpy as np
import matplotlib.pyplot as plt


# ─────────────────────────────────────────────
# CONSTANTS
# ─────────────────────────────────────────────

T0              = 37.0    # Initial body temperature (°C)
T_env           = 22.0    # ISS environment temperature (°C)
T_target        = 36.0    # Sleep onset threshold (°C)
k_earth         = 0.05    # Heat dissipation coefficient — Earth
k_space         = 0.015   # Heat dissipation coefficient — microgravity
kp              = 0.3     # Proportional gain
metabolic_rate  = 0.008   # Metabolic heat generation (°C/min, ~80W at rest)
NOISE_STD       = 0.05    # Sensor noise standard deviation
MA_WINDOW       = 5       # Moving average window size
STABILITY_DELTA = 0.01    # Max temp change to consider body stable
TIMEOUT_LIMIT   = 15      # Minutes above target before fallback activates


# ─────────────────────────────────────────────
# SIMULATION
# ─────────────────────────────────────────────

def simulate(k, cooling=False, duration=120):
    """
    Simulates body temperature regulation in microgravity.

    Features:
    - Newtonian cooling + metabolic heat generation
    - Sensor noise + moving average filtering
    - Closed-loop proportional control
    - State-based activation (stability detection)
    - Timeout fallback to prevent deadlock

    Physics uses true temperature.
    Control decisions use measured (noisy) temperature.
    This distinction is critical — noise affects decisions, not reality.

    Args:
        k (float): Heat dissipation coefficient
        cooling (bool): Whether Lunelle thermal control is active
        duration (int): Simulation time in minutes

    Returns:
        np.array: True body temperature over time
    """
    T = [T0]
    time_above_target = 0

    for t in range(1, duration):
        current = T[-1]

        # ── Measurement: moving average + Gaussian noise ──
        window = T[-MA_WINDOW:] if len(T) >= MA_WINDOW else T
        current_measured = np.mean(window) + np.random.normal(0, NOISE_STD)

        # ── Stability: rate of change between last two readings ──
        delta = abs(T[-1] - T[-2]) if t > 1 else 0

        # ── Physics: Newton's Law + metabolic heat ──
        dT = -k * (current - T_env) + metabolic_rate

        # ── Timeout fallback tracking ──
        if current_measured > T_target:
            time_above_target += 1
        else:
            time_above_target = 0

        # ── Control logic ──
        # Primary:  stable body + above target → activate cooling
        # Fallback: above target too long → activate regardless
        if cooling and (
            (current_measured > T_target and delta < STABILITY_DELTA)
            or (time_above_target > TIMEOUT_LIMIT)
        ):
            error = current_measured - T_target
            dT -= kp * error   # proportional correction

        # ── Update true state ──
        T.append(current + dT)

    return np.array(T)


# ─────────────────────────────────────────────
# PLOT
# ─────────────────────────────────────────────

def plot(duration=120):
    """Three-scenario thermal comparison."""
    time    = np.arange(duration)
    earth   = simulate(k_earth, cooling=False, duration=duration)
    space   = simulate(k_space, cooling=False, duration=duration)
    lunelle = simulate(k_space, cooling=True,  duration=duration)

    plt.figure(figsize=(11, 6))
    plt.plot(time, earth,   label="Earth (Normal Cooling)",    linewidth=2)
    plt.plot(time, space,   label="Microgravity (No Control)", linewidth=2)
    plt.plot(time, lunelle, label="Lunelle Intervention",      linewidth=2, color='green')
    plt.axhline(T_target, linestyle='--', color='gray',
                label=f"Sleep Threshold ({T_target}°C)")
    plt.xlabel("Time (minutes)")
    plt.ylabel("Core Body Temperature (°C)")
    plt.title("Lunelle Day 1 — Thermal Regulation in Microgravity")
    plt.legend()
    plt.grid(alpha=0.3)
    plt.tight_layout()
    plt.show()


# ─────────────────────────────────────────────
# MAIN
# ─────────────────────────────────────────────

if __name__ == "__main__":
    print("Lunelle Day 1 — Thermal Simulation")
    print(f"  Target: {T_target}°C  |  Environment: {T_env}°C")
    print(f"  k_earth={k_earth}  |  k_space={k_space}  |  kp={kp}")
    print(f"  metabolic_rate={metabolic_rate} °C/min")
    print("\nRunning simulation...")
    plot()
    print("Done. Next: Day 2 — CO2 module + unified system.")
